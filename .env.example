# Copie este arquivo para .env e coloque sua chave (o .env não vai pro git)
ANTHROPIC_API_KEY=sk-ant-...

# Opcional: modelo usado pela IA (padrão: claude-haiku-5-5, o mais barato)
# ENGLISH_ZE_MODEL=claude-sonnet-5-5

# Senha de acesso ao app (obrigatória pra usar o --lan / celular)
ENGLISH_ZE_PASSWORD=troque-esta-senha

# Banco de dados (PostgreSQL). Troque SENHA pela senha do usuário english_ze (veja o README)
DATABASE_URL=postgresql://english_ze:SENHA@localhost:5432/english_ze
# Banco só dos testes: é apagado a cada teste, então o nome precisa terminar em _test
TEST_DATABASE_URL=postgresql://english_ze:SENHA@localhost:5432/english_ze_test

# Opcional: fuso usado pra decidir o "hoje" das revisões (padrão: America/Sao_Paulo)
# ENGLISH_ZE_TIMEZONE=America/Sao_Paulo
