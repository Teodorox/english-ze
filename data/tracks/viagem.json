{
  "category": "viagem",
  "situations": [
    {
      "level": "iniciante",
      "title": "No aeroporto",
      "cards": [
        {
          "front": "Where is the check-in counter?",
          "back": "Onde fica o balcão do check-in?",
          "traps": [
            "Onde fica a esteira de bagagem?",
            "Quando abre o check-in?"
          ]
        },
        {
          "front": "Here's my passport.",
          "back": "Aqui está meu passaporte.",
          "traps": [
            "Aqui está minha passagem.",
            "Cadê meu passaporte?"
          ]
        },
        {
          "front": "I have one bag to check.",
          "back": "Tenho uma mala pra despachar.",
          "note": "\"check a bag\" = despachar mala.",
          "traps": [
            "Tenho uma mala de mão.",
            "Tenho uma mala pra conferir."
          ]
        },
        {
          "front": "Can I take this on the plane?",
          "back": "Posso levar isso no avião?",
          "traps": [
            "Posso tirar isso do avião?",
            "Posso comprar isso no avião?"
          ]
        },
        {
          "front": "Where is gate 12?",
          "back": "Onde fica o portão 12?",
          "note": "gate = portão de embarque.",
          "traps": [
            "Onde fica o assento 12?",
            "Quando abre o portão 12?"
          ]
        },
        {
          "front": "Is this flight delayed?",
          "back": "Esse voo está atrasado?",
          "note": "delayed = atrasado. canceled = cancelado.",
          "traps": [
            "Esse voo foi cancelado?",
            "Esse voo está no horário?"
          ]
        },
        {
          "front": "Window or aisle?",
          "back": "Janela ou corredor?",
          "note": "aisle (lê-se \"ail\") = corredor.",
          "traps": [
            "Janela ou meio?",
            "Porta ou corredor?"
          ]
        }
      ]
    },
    {
      "level": "iniciante",
      "title": "Na imigração",
      "cards": [
        {
          "front": "I'm here on vacation.",
          "back": "Estou aqui de férias.",
          "traps": [
            "Estou aqui a trabalho.",
            "Estou aqui de passagem."
          ]
        },
        {
          "front": "This is my first time here.",
          "back": "É minha primeira vez aqui.",
          "traps": [
            "Já vim aqui antes.",
            "É minha última vez aqui."
          ]
        },
        {
          "front": "I'm staying for two weeks.",
          "back": "Vou ficar duas semanas.",
          "traps": [
            "Vou ficar dois meses.",
            "Fiquei duas semanas."
          ]
        },
        {
          "front": "I'm staying at a hotel downtown.",
          "back": "Vou ficar num hotel no centro.",
          "note": "downtown = centro da cidade.",
          "traps": [
            "Vou ficar num hotel perto do aeroporto.",
            "Vou ficar na casa de um amigo no centro."
          ]
        },
        {
          "front": "I'm traveling with my family.",
          "back": "Estou viajando com minha família.",
          "traps": [
            "Estou viajando sozinho.",
            "Estou viajando com meus amigos."
          ]
        }
      ]
    },
    {
      "level": "iniciante",
      "title": "No hotel",
      "cards": [
        {
          "front": "I have a reservation under Silva.",
          "back": "Tenho uma reserva no nome de Silva.",
          "note": "\"under (nome)\" = no nome de.",
          "traps": [
            "Tenho uma reserva embaixo do Silva.",
            "Quero fazer uma reserva no nome de Silva."
          ]
        },
        {
          "front": "What time is check-out?",
          "back": "Que horas é o check-out?",
          "traps": [
            "Que horas é o check-in?",
            "Que horas é o café da manhã?"
          ]
        },
        {
          "front": "Is breakfast included?",
          "back": "O café da manhã está incluído?",
          "traps": [
            "O jantar está incluído?",
            "Onde é o café da manhã?"
          ]
        },
        {
          "front": "What's the Wi-Fi password?",
          "back": "Qual é a senha do Wi-Fi?",
          "traps": [
            "Qual é o nome do Wi-Fi?",
            "O Wi-Fi é de graça?"
          ]
        },
        {
          "front": "Could I get an extra towel?",
          "back": "Pode me trazer uma toalha extra?",
