        {
          "front": "Is it within walking distance?",
          "back": "Dá pra ir a pé?",
          "traps": [
            "Dá pra ir de ônibus?",
            "É longe pra ir a pé?"
          ]
        },
        {
          "front": "Go straight ahead.",
          "back": "Siga em frente.",
          "traps": [
            "Vire à direita.",
            "Volte pra trás."
          ]
        },
        {
          "front": "Turn left at the corner.",
          "back": "Vire à esquerda na esquina.",
          "traps": [
            "Vire à direita na esquina.",
            "Vire à esquerda no semáforo."
          ]
        }
      ]
    },
    {
