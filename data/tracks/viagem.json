          "traps": [
            "Uma mesa pra quatro, por favor.",
            "Dois cafés, por favor."
          ]
        },
        {
          "front": "Can I see the menu?",
          "back": "Posso ver o cardápio?",
          "traps": [
            "Posso ver a conta?",
            "Posso ver a cozinha?"
          ]
        },
        {
          "front": "I'll have the chicken.",
          "back": "Vou querer o frango.",
          "note": "\"I'll have...\" = jeito natural de pedir.",
          "traps": [
            "Vou querer o peixe.",
            "Eu tenho frango."
          ]
